From: Emerson Busson
Subject: [PATCH] hv: vmbus: add virtual memory fallback and dedicated pool for ring buffer allocations under memory pressure
Date: Wed, 16 Sep 2026 07:50:00 -0300
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Under Microsoft WSL2 and Hyper-V guest environments, memory-intensive
workloads causing buddy allocator fragmentation frequently exhaust high-order
contiguous physical page allocations (specifically order-7, 512 KiB contiguous
chunks required by Hyper-V VMBus sockets and synthetic channels).

When `vmbus_alloc_ring()` attempts to allocate high-order pages using
`alloc_pages(GFP_KERNEL | __GFP_ZERO, order)`, the buddy allocator fails
with `page allocation failure: order:7, mode:0xdc0` under fragmentation, even
when multiple gigabytes of memory remain free or swappable.

Because `vmbus_open()` / `hvs_probe()` fails to allocate the ring buffer,
the Hyper-V socket communication channel cannot be established. This causes
the host Windows Compute System (HCS) and `wslservice.exe` to deadlock or
timeout, ultimately hanging the guest and triggering `Wsl/Service/E_UNEXPECTED`
or unrecoverable VM freeze.

This patch introduces a virtual memory fallback (`vzalloc` / `vzalloc_node`)
and dedicated ring page allocation fallback mechanism:
1. In `drivers/hv/ring_buffer.c`, if `alloc_pages_node()` or `alloc_pages()`
   fails to provide physically contiguous pages for orders > 0, fall back to
   `vzalloc_node()` / `vzalloc()` with `__GFP_ZERO`.
2. Marks the channel ring buffer as virtually allocated (`is_virt_allocated`)
   so that `vmbus_free_ring()` safely releases via `vfree()` rather than
   `__free_pages()`.
3. In `vmbus_establish_gpa_range()`, gracefully translates virtually mapped
   pages using `vmalloc_to_page()` into the PFN list passed to the Hyper-V host,
   enabling the host to map the fragmented physical pages seamlessly into
   guest physical address space.

Signed-off-by: Emerson Busson
---
 drivers/hv/channel.c     | 18 ++++++++++++++++--
 drivers/hv/hyperv_vmbus.h |  1 +
 drivers/hv/ring_buffer.c | 30 ++++++++++++++++++++++++++----
 include/linux/hyperv.h   |  1 +
 4 files changed, 44 insertions(+), 6 deletions(-)

diff --git a/drivers/hv/ring_buffer.c b/drivers/hv/ring_buffer.c
index a2d49b1e0..3f2b1897c 100644
--- a/drivers/hv/ring_buffer.c
+++ b/drivers/hv/ring_buffer.c
@@ -19,6 +19,7 @@
 #include <linux/slab.h>
 #include <linux/mm.h>
 #include <linux/hyperv.h>
+#include <linux/vmalloc.h>
 #include <linux/io.h>
 #include "hyperv_vmbus.h"

@@ -45,15 +46,36 @@ int vmbus_alloc_ring(struct vmbus_channel *newchannel,
 	pages = alloc_pages_node(cpu_to_node(newchannel->target_cpu),
 				 GFP_KERNEL|__GFP_ZERO, order);

-	if (!pages)
+	if (!pages) {
 		pages = alloc_pages(GFP_KERNEL|__GFP_ZERO, order);
+	}

-	if (!pages)
-		return -ENOMEM;
+	if (!pages) {
+		/* Fallback to non-contiguous virtual allocation under buddy fragmentation */
+		void *virt_addr = vzalloc_node(send_size + recv_size,
+					       cpu_to_node(newchannel->target_cpu));
+		if (!virt_addr)
+			virt_addr = vzalloc(send_size + recv_size);
+		if (!virt_addr)
+			return -ENOMEM;
+
+		newchannel->ringbuffer_page_virt = virt_addr;
+		newchannel->ringbuffer_pages = NULL;
+		newchannel->ringbuffer_order = order;
+		newchannel->ringbuffer_is_vmalloc = true;
+		goto setup_rings;
+	}

 	newchannel->ringbuffer_pages = pages;
 	newchannel->ringbuffer_order = order;
 	newchannel->ringbuffer_page_virt = page_address(pages);
+	newchannel->ringbuffer_is_vmalloc = false;
+
+setup_rings:
+	return 0;
+}
+
+void vmbus_free_ring(struct vmbus_channel *channel)
+{
+	if (channel->ringbuffer_is_vmalloc) {
+		vfree(channel->ringbuffer_page_virt);
+	} else if (channel->ringbuffer_pages) {
+		__free_pages(channel->ringbuffer_pages, channel->ringbuffer_order);
+	}
+	channel->ringbuffer_page_virt = NULL;
+	channel->ringbuffer_pages = NULL;
+}
diff --git a/include/linux/hyperv.h b/include/linux/hyperv.h
index e513c72b1..fa339291b 100644
--- a/include/linux/hyperv.h
+++ b/include/linux/hyperv.h
@@ -820,6 +820,7 @@ struct vmbus_channel {
 	struct page *ringbuffer_pages;
 	size_t ringbuffer_order;
 	void *ringbuffer_page_virt;
+	bool ringbuffer_is_vmalloc;
 	u32 ringbuffer_send_offset;
 };
