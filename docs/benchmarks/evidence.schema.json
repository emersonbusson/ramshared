{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ramshared-evidence/v1",
  "title": "RamShared public benchmark evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_id", "surface", "slug", "utc", "source",
    "platform", "candidate", "workload", "comparison", "metrics",
    "lifecycle", "artifacts", "decision"
  ],
  "properties": {
    "schema_version": { "const": "ramshared-evidence/v1" },
    "run_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$" },
    "surface": { "type": "string", "minLength": 1, "maxLength": 64 },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "utc": {
      "type": "object",
      "required": ["started", "ended"],
      "properties": { "started": { "type": "string", "format": "date-time" }, "ended": { "type": "string", "format": "date-time" } }
    },
    "source": {
      "type": "object",
      "required": ["commit", "dirty", "dirty_entry_count", "invocation", "harness_revision"]
    },
    "platform": { "type": "object", "minProperties": 1 },
    "candidate": { "type": "object", "minProperties": 1 },
    "workload": {
      "type": "object",
      "required": ["profile", "parameters", "warmup_seconds", "runs"],
      "properties": { "runs": { "type": "integer", "minimum": 3 } }
    },
    "comparison": {
      "type": "object",
      "required": ["platform_fingerprint", "baseline_run_id", "baseline_fingerprint", "qualified"]
    },
    "metrics": { "type": "object", "minProperties": 1 },
    "lifecycle": {
      "type": "object",
      "required": ["before", "action", "after", "binary_match", "legitimate", "refusals", "cleanup", "residue"]
    },
    "artifacts": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "required": ["path", "bytes", "sha256"],
        "properties": {
          "path": { "type": "string", "maxLength": 512 },
          "bytes": { "type": "integer", "minimum": 0, "maximum": 1073741824 },
          "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" }
        }
      }
    },
    "decision": {
      "type": "object",
      "required": ["verdict", "promotable", "gaps", "rollback_trigger"],
      "properties": {
        "verdict": { "enum": ["RED", "YELLOW", "INCOMPARABLE", "BASELINE", "PASS"] },
        "promotable": { "type": "boolean" }
      }
    }
  }
}
