[Unit]
Description=RamShared cascade health sampler (JSONL append-only)
Documentation=file:///opt/ramshared/current/README.md
After=local-fs.target

[Service]
Type=simple
User=root
# Typed read-only observer. It cannot change swap or create pressure.
ExecStart=/opt/ramshared/current/bin/ramshared monitor --jsonl --output /var/log/ramshared/cascade-health.jsonl --heartbeat /mnt/c/wsl-forensics/ramshared-heartbeat.json --interval-ms 2000
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
