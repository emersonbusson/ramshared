[Unit]
Requires=ramshared-host-gate.service
After=ramshared-host-gate.service
Description=RamShared sealed NBD-only cascade (scoped approval required)
Documentation=file:///opt/ramshared/current/scripts/safety/nbd-product-preflight.sh
After=local-fs.target
ConditionPathExists=!/var/lib/ramshared/safe-mode.json
ConditionPathExists=/run/ramshared/host-resume-lease.json

[Service]
Type=simple
Slice=ramshared-control.slice
User=root
# No approval is embedded here. A version-scoped override supplies only
# RAMSHARED_NBD_CONTROLLER_APPROVAL=lifecycle:<version>.
ExecStartPre=/opt/ramshared/current/scripts/safety/nbd-product-preflight.sh --check
ExecStart=/opt/ramshared/current/scripts/safety/cascade-controller.sh --execute
# systemd signals only the controller. The controller retries swapoff and
# detach forever; systemd never escalates to the backend process.
KillMode=process
SendSIGKILL=no
TimeoutStartSec=120
TimeoutStopSec=infinity
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
