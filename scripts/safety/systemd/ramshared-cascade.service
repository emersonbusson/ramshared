[Unit]
Description=RamShared sealed NBD-only cascade (scoped approval required)
Documentation=file:///opt/ramshared/current/scripts/safety/nbd-product-preflight.sh
After=local-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=root
# No approval is embedded here. Without a version-scoped systemd override the
# lifecycle scripts plan/refuse and cannot start a cascade unattended.
ExecStartPre=/opt/ramshared/current/scripts/safety/nbd-product-preflight.sh --check
ExecStart=/opt/ramshared/current/scripts/safety/cascade-up.sh --execute
ExecStop=/opt/ramshared/current/scripts/safety/cascade-down.sh --execute
TimeoutStartSec=120
TimeoutStopSec=600
Restart=no
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
