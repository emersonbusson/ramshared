# Sealed NBD cascade configuration for one release.
#
# This file is packaged inside /opt/ramshared/releases/<version>. It is not
# sourced as shell code. Change a setting by publishing and selecting another
# sealed version; never edit a selected release in place.

# The current source-only gate permits the 1 GiB pilot configuration only.
VRAM_MIB=1024
ZRAM_MIB=1024

# The package builder replaces these three values together. They bind one
# machine-specific lower tier by canonical path, directory type, and an exact
# filesystem identity digest. A live product preflight never accepts an
# environment override: publish a new sealed release instead.
NBD_LOWER_SINK=
NBD_LOWER_SINK_TYPE=directory
NBD_LOWER_SINK_IDENTITY_SHA256=
NBD_LOWER_SINK_FS_BLOCK_BYTES=
NBD_LOWER_SINK_BINDING=unbound
