# Sealed NBD cascade configuration for one release.
#
# This file is packaged inside /opt/ramshared/releases/<version>. It is not
# sourced as shell code. Change a setting by publishing and selecting another
# sealed version; never edit a selected release in place.

# The current source-only gate permits the 1 GiB pilot configuration only.
VRAM_MIB=1024
ZRAM_MIB=1024

# An operator-approved release must contain exactly one existing lower-tier
# directory. Leave this empty in a generic bundle so the read-only preflight
# refuses instead of guessing a host path. The check also accepts a scoped
# RAMSHARED_NBD_LOWER_SINK override for an attended, approved execution.
NBD_LOWER_SINK=
