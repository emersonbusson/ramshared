     }
+
+    #[test]
+    fn server_drain_syncs_cq() {
+        let page = page_size();
+        let (path, file) = regular_file_fixture("ublk-cq-sync", page);
+        let fd = file.as_raw_fd();
+
+        let mut server = UblkServer::new(fd, 2, 4096).expect("server setup");
+
+        server.submit_initial_fetch().expect("submit initial");
+
+        // Ensure wait_and_drain doesn't hang
+        let completions = server.wait_and_drain().expect("wait and drain");
+        assert!(!completions.is_empty());
+
+        drop(server);
+        drop(file);
+        fs::remove_file(path).expect("remove regular-file fixture");
+    }
 }
