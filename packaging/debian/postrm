#!/bin/sh
set -euo pipefail

cleanup_dir() {
    target_dir="$1"
    if test -d "$target_dir"; then
        if command -v rm >/dev/null 2>&1; then
            rm -rf "$target_dir"
        fi
    fi
}

case "${1:-}" in
    purge)
        cleanup_dir "/var/run/ramshared"
        cleanup_dir "/run/ramshared"
        cleanup_dir "/var/log/ramshared"
        ;;
    remove|upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        ;;
    *)
        echo "postrm called with unknown argument '${1:-}'" >&2
        exit 1
        ;;
esac

#DEBHELPER#
exit 0
